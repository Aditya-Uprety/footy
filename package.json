{
  "name": "footy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser 3D turn-based football (Three.js), hot-seat and online P2P.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "sim:table": "node scripts/sim-table.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "peerjs": "1.5.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
